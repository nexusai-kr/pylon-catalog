{
  "schema_version": 1,
  "name": "slack",
  "version": "1.0.0",
  "display_name": "Slack (읽기 전용)",
  "description": "메시지·채널·캔버스 검색과 읽기",
  "category": "협업",
  "provider": {
    "kind": "oauth2",
    "display": "Slack (메시지·채널·캔버스)",
    "setup": {
      "docs_url": "https://docs.slack.dev/ai/slack-mcp-server/",
      "restriction": "회사(워크스페이스) 계정만 연결할 수 있습니다",
      "steps": [
        "https://api.slack.com/apps 에서 Create New App > From a manifest 로 앱을 만든다 (아래 manifest 를 붙여 넣는다)",
        "앱 설정 > Agents > Slack Model Context Protocol (MCP) Server 토글을 켠다 (꺼져 있으면 연결은 되는데 도구가 비어 있다)",
        "OAuth & Permissions > Redirect URLs 에 위의 Redirect URL 이 들어 있는지 확인한다",
        "Basic Information > App Credentials 의 Client ID 와 Client Secret 을 아래에 입력한다"
      ],
      "manifest": "{\n  \"display_information\": {\n    \"name\": \"Pylon\",\n    \"description\": \"Pylon AI 에이전트가 사용자의 Slack 을 읽고 검색합니다.\"\n  },\n  \"oauth_config\": {\n    \"redirect_urls\": [\n      \"{redirect_url}\"\n    ],\n    \"scopes\": {\n      \"user\": [\n        \"search:read.public\",\n        \"search:read.private\",\n        \"search:read.mpim\",\n        \"search:read.im\",\n        \"search:read.files\",\n        \"search:read.users\",\n        \"channels:history\",\n        \"groups:history\",\n        \"mpim:history\",\n        \"im:history\",\n        \"channels:read\",\n        \"groups:read\",\n        \"mpim:read\",\n        \"im:read\",\n        \"users:read\",\n        \"canvases:read\",\n        \"files:read\",\n        \"reactions:read\"\n      ]\n    }\n  },\n  \"settings\": {\n    \"org_deploy_enabled\": false,\n    \"socket_mode_enabled\": false,\n    \"token_rotation_enabled\": false\n  }\n}"
    },
    "authorize_url": "https://slack.com/oauth/v2_user/authorize",
    "token_url": "https://slack.com/api/oauth.v2.user.access",
    "refresh_token": "none",
    "pkce": false,
    "offline_scope": false,
    "scope_separator": ",",
    "max_accounts": 3,
    "scopes_allowed": [
      "search:read.public",
      "search:read.private",
      "search:read.mpim",
      "search:read.im",
      "search:read.files",
      "search:read.users",
      "channels:history",
      "groups:history",
      "mpim:history",
      "im:history",
      "channels:read",
      "groups:read",
      "mpim:read",
      "im:read",
      "users:read",
      "users:read.email",
      "canvases:read",
      "files:read",
      "reactions:read",
      "chat:write"
    ],
    "default_scopes": [
      "search:read.public",
      "search:read.private",
      "search:read.mpim",
      "search:read.im",
      "search:read.files",
      "search:read.users",
      "channels:history",
      "groups:history",
      "mpim:history",
      "im:history",
      "channels:read",
      "groups:read",
      "mpim:read",
      "im:read",
      "users:read",
      "canvases:read",
      "files:read",
      "reactions:read"
    ],
    "identity_check": {
      "claim": "login",
      "attribute": "login",
      "mode": "none"
    },
    "account_key_claim": "sub",
    "token_paths": {
      "scope": "authed_user.scope"
    },
    "userinfo": {
      "url": "https://slack.com/api/auth.test",
      "method": "POST",
      "map": {
        "sub": "user_id",
        "login": "user"
      }
    },
    "revoke": {
      "url": "https://slack.com/api/auth.revoke",
      "auth": "bearer"
    }
  },
  "servers": [
    {
      "name": "slack",
      "url": "https://mcp.slack.com/mcp",
      "display_name": "Slack (읽기 전용)",
      "description": "메시지·채널·캔버스 검색과 읽기",
      "delegation": {
        "when": "always",
        "header": "Authorization",
        "scheme": "Bearer",
        "discovery": "snapshot"
      }
    }
  ],
  "fields": [
    {
      "key": "client_id",
      "label": "Client ID",
      "secret": false,
      "pattern": "^\\S+$"
    },
    {
      "key": "client_secret",
      "label": "Client Secret",
      "secret": true
    }
  ]
}
